# Leave a channel's variables empty to disable it.

# --- Telegram (bot from @BotFather; chat id of the user or group that receives the messages) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email ---
SMTP_SERVER=
SMTP_PORT=587
# starttls (default, port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
EMAIL_SUBJECT=Notification

# --- Logging: also write to this file (stdout is always on). Empty = stdout only. ---
LOG_FILE=
